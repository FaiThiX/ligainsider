# Required Discord application settings
DISCORD_TOKEN=replace-with-your-bot-token
DISCORD_APPLICATION_ID=replace-with-your-application-id
DISCORD_GUILD_ID=replace-with-your-guild-id

# Public HTTPS origin used to build private RSS URLs
PUBLIC_BASE_URL=https://feeds.example.com

# Optional service settings
PORT=3000
DATABASE_PATH=/data/player-news.sqlite
POLL_INTERVAL_MINUTES=30
CHANNEL_CATEGORY_NAME=Player Updates
CHANNEL_DELETE_GRACE_HOURS=72
SOURCE_REQUEST_DELAY_MS=1000
SOURCE_REQUEST_TIMEOUT_MS=15000
SOURCE_MAX_RETRIES=2
SOURCE_MAX_CATCHUP_PAGES=10
LOG_LEVEL=info

# Optional Docker Compose settings
HOST_PORT=3000
IMAGE_NAME=player-news-discord-bot:local
DATA_VOLUME_NAME=player-news-data
